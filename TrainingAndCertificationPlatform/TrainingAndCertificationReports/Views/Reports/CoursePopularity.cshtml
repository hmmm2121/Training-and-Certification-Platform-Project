@model List<CoursePopularityViewModel>

@{
    ViewData["Title"] = "Course Popularity";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
else if (!Model.Any())
{
    <div class="alert alert-info">No course enrollment data available.</div>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="text-muted small">Most popular course</div>
            <div class="h5 mb-0">
                @Model.First().Course
                <span class="text-muted small">(@Model.First().TotalEnrollments enrollments)</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <strong>Courses by popularity</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Course</th>
                        <th>Subject</th>
                        <th class="text-end">Total enrollments</th>
                        <th class="text-end">Capacity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var nearFull = item.TotalEnrollments >= item.AvailableCapacity * 0.8;
                        <tr class="@(nearFull ? "table-warning" : "")">
                            <td>@item.Course</td>
                            <td>@item.Subject</td>
                            <td class="text-end">@item.TotalEnrollments</td>
                            <td class="text-end">@item.AvailableCapacity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}