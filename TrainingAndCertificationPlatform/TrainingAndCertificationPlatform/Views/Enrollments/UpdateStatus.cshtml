@model TrainingAndCertificationPlatform.Models.Enrollment

@{
    ViewData["Title"] = "Update Enrollment Status";
    var allowedStatuses = ViewBag.AllowedStatuses as List<string> ?? new List<string>();
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">

        <div class="text-center mb-4">
            <h1 class="fw-bold">Update Status</h1>
            <p class="text-muted">Move this enrollment to its next valid status.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <div class="fw-bold">Trainee</div>
                    <div>@Model.Trainee?.FullName</div>
                </div>

                <div class="mb-3">
                    <div class="fw-bold">Course</div>
                    <div>@Model.Session?.Course?.Title</div>
                </div>

                <div class="mb-4">
                    <div class="fw-bold">Current Status</div>
                    <span class="badge bg-secondary">@Model.Status</span>
                </div>

                @if (allowedStatuses.Any())
                {
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.EnrollmentId" />

                        <div class="mb-4">
                            <label class="form-label">New Status</label>
                            <select name="newStatus" class="form-select">
                                @foreach (var status in allowedStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 mb-3">Update Status</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Back to Enrollments</a>
                    </form>
                }
                else
                {
                    <p class="text-muted">This enrollment is in a final status (@Model.Status) and cannot be changed.</p>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Back to Enrollments</a>
                }

            </div>
        </div>

    </div>
</div>
