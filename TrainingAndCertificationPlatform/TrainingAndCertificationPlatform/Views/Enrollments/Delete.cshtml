@model TrainingAndCertificationPlatform.Models.Enrollment
@{
    ViewData["Title"] = "Delete Enrollment";
}

<h1>Delete Enrollment</h1>
<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Enrollment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Trainee</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Trainee.FullName)</dd>


        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Session.Course.Title)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EnrolledAt)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EnrolledAt)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="EnrollmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>