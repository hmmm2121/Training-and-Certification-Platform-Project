@model TrainingAndCertificationPlatform.Models.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Enrollment
        </h1>

        <p class="text-muted">
            Review the enrollment information before deleting it permanently.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this enrollment?
        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Trainee
            </div>

            <div class="col-md-9">
                @Model.Trainee.FullName
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Course
            </div>

            <div class="col-md-9">
                @Model.Session.Course.Title
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Enrolled At
            </div>

            <div class="col-md-9">
                @Model.EnrolledAt
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Status
            </div>

            <div class="col-md-9">

                <span class="badge bg-@(Model.Status == "Active" ? "success" :
                                                               Model.Status == "Withdrawn" ? "danger" :
                                                               "secondary")">

                    @Model.Status

                </span>

            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="EnrollmentId" />

            <div class="d-flex gap-2">

                <input type="submit"
                       value="Delete Enrollment"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Enrollments
                </a>

            </div>

        </form>

    </div>

</div>