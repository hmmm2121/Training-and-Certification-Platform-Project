@model IEnumerable<TrainingAndCertificationPlatform.Models.Enrollment>
@{
    ViewData["Title"] = "Enrollments";
}

<h1>Enrollments</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Trainee</th>
            <th>Session</th>
            <th>Course</th>
            <th>@Html.DisplayNameFor(model => model.EnrolledAt)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Trainee.FullName)</td>
                <td>@Html.DisplayFor(modelItem => item.Session.Course.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.EnrolledAt)</td>
                <td>
                    <span class="badge bg-@(item.Status == "Active" ? "success" : item.Status == "Withdrawn" ? "danger" : "secondary")">
                        @Html.DisplayFor(modelItem => item.Status)
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EnrollmentId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EnrollmentId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EnrollmentId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>