@model TrainingAndCertificationPlatform.Models.Enrollment

@{
    ViewData["Title"] = "Edit Enrollment";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">

        <div class="text-center mb-4">

            <h1 class="fw-bold">
                Edit Enrollment
            </h1>

            <p class="text-muted">
                Update trainee enrollment details and status.
            </p>

        </div>

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden" asp-for="EnrollmentId" />
            <input type="hidden" asp-for="EnrolledAt" />

            <div class="mb-3">

                <label asp-for="TraineeId"
                       class="form-label">
                </label>

                <select asp-for="TraineeId"
                        class="form-select"
                        asp-items="ViewBag.TraineeId">
                </select>

                <span asp-validation-for="TraineeId"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="SessionId"
                       class="form-label">
                </label>

                <select asp-for="SessionId"
                        class="form-select"
                        asp-items="ViewBag.SessionId">
                </select>

                <span asp-validation-for="SessionId"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-dark w-100 mb-3">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary w-100">
                Back to Enrollments
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}