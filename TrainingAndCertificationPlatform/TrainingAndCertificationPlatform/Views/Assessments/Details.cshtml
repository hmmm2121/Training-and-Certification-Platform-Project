@model TrainingAndCertificationPlatform.Models.Assessment

@{
    ViewData["Title"] = "Assessment Details";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            Assessment Details
        </h1>

        <p class="text-muted">
            View complete information about this trainee assessment.
        </p>

    </div>

    <div class="card shadow-sm p-4">

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Result
            </div>

            <div class="col-md-9">

                @if (Model.Result == "Pass")
                {
                    <span class="badge bg-success">
                        Pass
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Fail
                    </span>
                }

            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Notes
            </div>

            <div class="col-md-9">
                @Model.Notes
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Recorded At
            </div>

            <div class="col-md-9">
                @Model.RecordedAt
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Enrollment
            </div>

            <div class="col-md-9">
                @Model.Enrollment?.Trainee?.FullName -
                @Model.Enrollment?.Session?.Course?.Title
            </div>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.AssessmentId"
               class="btn btn-dark">
                Edit Assessment
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Assessments
            </a>

        </div>

    </div>

</div>