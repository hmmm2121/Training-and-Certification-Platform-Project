@model TrainingAndCertificationPlatform.Models.Assessment

@{
    ViewData["Title"] = "Delete Assessment";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Assessment
        </h1>

        <p class="text-muted">
            Review the assessment details before deleting it permanently.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this assessment?
        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Result
            </div>

            <div class="col-md-9">

                @if (Model.Result == "Pass")
                {
                    <span class="badge bg-success">
                        Pass
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Fail
                    </span>
                }

            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Notes
            </div>

            <div class="col-md-9">
                @Model.Notes
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Recorded At
            </div>

            <div class="col-md-9">
                @Model.RecordedAt
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Enrollment ID
            </div>

            <div class="col-md-9">
                @Model.Enrollment?.EnrollmentId
            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="AssessmentId" />

            <div class="d-flex gap-2">

                <input type="submit"
                       value="Delete Assessment"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Assessments
                </a>

            </div>

        </form>

    </div>

</div>