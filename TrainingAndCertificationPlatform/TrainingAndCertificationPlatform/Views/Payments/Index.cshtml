@model IEnumerable<TrainingAndCertificationPlatform.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold">Payments</h1>

        <p class="text-muted">
            Track trainee payment records, due dates, and payment status.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-dark">
        + Record Payment
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Trainee</th>
                    <th>Course</th>
                    <th>Amount</th>
                    <th>Due Date</th>
                    <th>Paid At</th>
                    <th>Status</th>
                    <th width="180">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No payments yet.
                        </td>
                    </tr>
                }

                @foreach (var payment in Model)
                {
                    <tr class="@(payment.IsOverdue ? "table-danger" : "")">

                        <td>@payment.Enrollment.Trainee.FullName</td>

                        <td>@payment.Enrollment.Session.Course.Title</td>

                        <td>@payment.Amount.ToString("C")</td>

                        <td>
                            @payment.DueDate.ToString("dd/MM/yyyy")

                            @if (payment.IsOverdue)
                            {
                                <span class="badge bg-danger ms-1">
                                    Overdue
                                </span>
                            }
                    </td>

                    <td>
                        @(payment.PaidAt.HasValue
                                                ? payment.PaidAt.Value.ToString("dd/MM/yyyy")
                                                : "Unpaid")
                    </td>

                        <td>
                        @if (payment.PaidAt.HasValue)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else if (payment.IsOverdue)
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@payment.PaymentId"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@payment.PaymentId"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>

                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>