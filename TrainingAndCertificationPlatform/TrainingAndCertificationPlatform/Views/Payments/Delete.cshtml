@model TrainingAndCertificationPlatform.Models.Payment
@{
    ViewData["Title"] = "Delete Payment";
}

<h1>Delete Payment</h1>
<h3>Are you sure you want to delete this payment?</h3>

<div>
    <h4>Payment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Trainee</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Enrollment.Trainee.FullName)</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Enrollment.Session.Course.Title)</dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Amount)
        </dt>
        <dd class="col-sm-10">@Model.Amount.ToString("C")</dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DueDate)
        </dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DueDate)</dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PaidAt)
        </dt>
        <dd class="col-sm-10">
            @(Model.PaidAt.HasValue? Model.PaidAt.Value.ToString("g") : "Not yet paid")
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="PaymentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>