@model TrainingAndCertificationPlatform.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Payment
        </h1>

        <p class="text-muted">
            Review the payment information before deleting it permanently.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this payment?
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Trainee</div>
            <div class="col-md-9">@Model.Enrollment.Trainee.FullName</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Course</div>
            <div class="col-md-9">@Model.Enrollment.Session.Course.Title</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Amount</div>
            <div class="col-md-9">@Model.Amount.ToString("C")</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Due Date</div>
            <div class="col-md-9">@Model.DueDate.ToString("dd/MM/yyyy")</div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 fw-bold">Paid At</div>
            <div class="col-md-9">
                @(Model.PaidAt.HasValue? Model.PaidAt.Value.ToString("g") : "Not yet paid")
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="PaymentId" />

            <div class="d-flex gap-2">
                <input type="submit"
                       value="Delete Payment"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Payments
                </a>
            </div>
        </form>

    </div>

</div>