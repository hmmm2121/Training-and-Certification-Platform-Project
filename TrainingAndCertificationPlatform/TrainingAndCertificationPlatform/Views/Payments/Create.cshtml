@model TrainingAndCertificationPlatform.Models.Payment

@{
    ViewData["Title"] = "Record Payment";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">

        <div class="text-center mb-4">

            <h1 class="fw-bold">
                Record Payment
            </h1>

            <p class="text-muted">
                Record a trainee payment and track its due date status.
            </p>

        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="EnrollmentId"
                       class="form-label">
                </label>

                <select asp-for="EnrollmentId"
                        class="form-select"
                        asp-items="ViewBag.EnrollmentId">

                    <option value="">-- Select Enrollment --</option>

                </select>

                <span asp-validation-for="EnrollmentId"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Amount"
                       class="form-label">
                </label>

                <input asp-for="Amount"
                       class="form-control"
                       placeholder="Enter payment amount" />

                <span asp-validation-for="Amount"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="DueDate"
                       class="form-label">
                </label>

                <input type="text"
                       id="DueDateDisplay"
                       class="form-control"
                       placeholder="DD/MM/YYYY" />

                <input type="hidden"
                       asp-for="DueDate"
                       id="DueDate" />

                <small class="text-muted">
                    Format: DD/MM/YYYY, for example 26/05/2026
                </small>

                <span asp-validation-for="DueDate"
                      class="text-danger">
                </span>

                <span id="dueDateError"
                      class="text-danger d-block">
                </span>

            </div>

            <div class="mb-4">

                <div class="form-check">

                    <input asp-for="IsOverdue"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsOverdue"
                           class="form-check-label">
                        Mark as Overdue
                    </label>

                </div>

            </div>

            <button type="submit"
                    class="btn btn-dark w-100 mb-3"
                    id="submitBtn">
                Record Payment
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary w-100">
                Back to Payments
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const displayInput = document.getElementById('DueDateDisplay');
        const hiddenInput = document.getElementById('DueDate');
        const dueDateError = document.getElementById('dueDateError');

        function validateAndConvert() {
            const value = displayInput.value.trim();
            dueDateError.textContent = '';
            hiddenInput.value = '';

            if (!value) return true;

            const slashFormat = /^(\d{2})\/(\d{2})\/(\d{4})$/;

            if (!slashFormat.test(value)) {
                dueDateError.textContent = 'Please enter a date in DD/MM/YYYY format.';
                return false;
            }

            const [, day, month, year] = value.match(slashFormat).map(Number);

            if (year > 2026) {
                dueDateError.textContent = 'Year cannot be beyond 2026.';
                return false;
            }

            const date = new Date(year, month - 1, day);

            if (
                date.getFullYear() !== year ||
                date.getMonth() + 1 !== month ||
                date.getDate() !== day
            ) {
                dueDateError.textContent = `"${value}" is not a valid calendar date.`;
                return false;
            }

            hiddenInput.value = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            return true;
        }

        displayInput.addEventListener('blur', validateAndConvert);

        displayInput.addEventListener('input', () => {
            if (dueDateError.textContent) validateAndConvert();
        });

        document.querySelector('form').addEventListener('submit', function (e) {
            if (!validateAndConvert()) {
                e.preventDefault();
            }
        });
    </script>
}