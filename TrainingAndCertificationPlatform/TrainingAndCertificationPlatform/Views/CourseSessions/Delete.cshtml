@model TrainingAndCertificationPlatform.Models.CourseSession

@{
    ViewData["Title"] = "Delete Course Session";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Course Session
        </h1>

        <p class="text-muted">
            Review the session details before deleting it permanently.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this course session?
        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Session Date
            </div>

            <div class="col-md-9">
                @Model.SessionDate
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Start Time
            </div>

            <div class="col-md-9">
                @Model.StartTime
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                End Time
            </div>

            <div class="col-md-9">
                @Model.EndTime
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Max Capacity
            </div>

            <div class="col-md-9">
                @Model.MaxCapacity
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Course
            </div>

            <div class="col-md-9">
                @Model.Course?.Title
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Instructor
            </div>

            <div class="col-md-9">
                @Model.Instructor?.FullName
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Room
            </div>

            <div class="col-md-9">
                @Model.Room?.RoomName
            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="SessionId" />

            <div class="d-flex gap-2">

                <input type="submit"
                       value="Delete Session"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Sessions
                </a>

            </div>

        </form>

    </div>

</div>