@model TrainingAndCertificationPlatform.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            Room Details
        </h1>

        <p class="text-muted">
            View room information and manage room equipment.
        </p>

    </div>

    <div class="card shadow-sm p-4 mb-4">

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Room Name
            </div>

            <div class="col-md-9">
                @Model.RoomName
            </div>

        </div>

        <div class="row">

            <div class="col-md-3 fw-bold">
                Capacity
            </div>

            <div class="col-md-9">
                @Model.Capacity
            </div>

        </div>

    </div>

    <div class="card shadow-sm p-4 mb-4">

        <h4 class="fw-bold mb-3">
            Equipment
        </h4>

        @if (!Model.RoomEquipments.Any())
        {
            <div class="alert alert-info">
                No equipment added yet.
            </div>
        }
        else
        {
            <table class="table table-hover">

                <thead class="table-light">
                    <tr>
                        <th>Equipment Name</th>
                        <th width="120">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var equipment in Model.RoomEquipments)
                    {
                        <tr>

                            <td>
                                @equipment.EquipmentName
                            </td>

                            <td>

                                <form asp-action="RemoveEquipment" method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="equipmentId"
                                           value="@equipment.EquipmentId" />

                                    <input type="hidden"
                                           name="roomId"
                                           value="@Model.RoomId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Remove
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

    <div class="card shadow-sm p-4 mb-4">

        <h5 class="fw-bold mb-3">
            Add Equipment
        </h5>

        <form asp-action="AddEquipment" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="roomId"
                   value="@Model.RoomId" />

            <div class="input-group">

                <input type="text"
                       name="equipmentName"
                       class="form-control"
                       placeholder="Enter equipment name" />

                <button type="submit"
                        class="btn btn-dark">
                    Add
                </button>

            </div>

        </form>

    </div>

    <div class="d-flex gap-2">

        <a asp-action="Edit"
           asp-route-id="@Model.RoomId"
           class="btn btn-dark">
            Edit Room
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Rooms
        </a>

    </div>

</div>