@model TrainingAndCertificationPlatform.Models.Room
@{
    ViewData["Title"] = "Details";
}
<h1>Details</h1>
<div>
    <h4>Room</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RoomName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RoomName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Capacity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Capacity)
        </dd>
    </dl>
</div>

<h4>Equipment</h4>
<hr />

@if (!Model.RoomEquipments.Any())
{
    <p>No equipment added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Equipment Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var equipment in Model.RoomEquipments)
            {
                <tr>
                    <td>@equipment.EquipmentName</td>
                    <td>
                        <form asp-action="RemoveEquipment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="equipmentId" value="@equipment.EquipmentId" />
                            <input type="hidden" name="roomId" value="@Model.RoomId" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h5>Add Equipment</h5>
<form asp-action="AddEquipment" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roomId" value="@Model.RoomId" />
    <div class="input-group mb-3">
        <input type="text" name="equipmentName" class="form-control" placeholder="Equipment name" />
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
</form>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.RoomId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>