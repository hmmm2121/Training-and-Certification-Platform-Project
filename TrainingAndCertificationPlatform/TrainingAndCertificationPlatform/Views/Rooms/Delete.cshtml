@model TrainingAndCertificationPlatform.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Room
        </h1>

        <p class="text-muted">
            Review the room information before deleting it permanently.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this room?
        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Room Name
            </div>

            <div class="col-md-9">
                @Model.RoomName
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Capacity
            </div>

            <div class="col-md-9">
                @Model.Capacity
            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="RoomId" />

            <div class="d-flex gap-2">

                <input type="submit"
                       value="Delete Room"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Rooms
                </a>

            </div>

        </form>

    </div>

</div>