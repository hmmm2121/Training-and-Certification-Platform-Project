@model TrainingAndCertificationPlatform.ViewModels.CertificationLookupViewModel
@{
    ViewData["Title"] = "Certification Lookup";
}

<h1>Certification Lookup</h1>
<p class="text-muted">Verify a trainee's certification by entering their Trainee ID and Certificate Reference Number.</p>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <div class="form-group">
                <label asp-for="TraineeId" class="control-label"></label>
                <input asp-for="TraineeId" class="form-control" placeholder="e.g. 1042" />
                <span asp-validation-for="TraineeId" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="CertificateRef" class="control-label"></label>
                <input asp-for="CertificateRef" class="form-control" placeholder="e.g. CERT-2024-00123" />
                <span asp-validation-for="CertificateRef" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Look Up" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@if (Model.Found == true)
{
    <hr />
    <div class="card mt-3" style="max-width: 600px;">
        <div class="card-header bg-success text-white">
            <strong>✓ Certification Verified</strong>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Trainee Name</dt>
                <dd class="col-sm-8">@Model.TraineeName</dd>

                <dt class="col-sm-4">Track</dt>
                <dd class="col-sm-8">@Model.TrackName</dd>

                <dt class="col-sm-4">Certificate Ref</dt>
                <dd class="col-sm-8">@Model.CertificateRef</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-@(Model.CertificationStatus == "Active" ? "success" : "secondary")">
                        @Model.CertificationStatus
                    </span>
                </dd>

                <dt class="col-sm-4">Issued At</dt>
                <dd class="col-sm-8">
                    @(Model.IssuedAt.HasValue? Model.IssuedAt.Value.ToString("MMMM dd, yyyy") : "—")
                </dd>
            </dl>
        </div>
    </div>

    @if (Model.CompletedCourses != null && Model.CompletedCourses.Any())
    {
        <div class="card mt-3" style="max-width: 600px;">
            <div class="card-header">Completed Courses</div>
            <ul class="list-group list-group-flush">
                @foreach (var course in Model.CompletedCourses)
                {
                    <li class="list-group-item">@course</li>
                }
            </ul>
        </div>
    }
}
else if (Model.Found == false)
{
    <div class="alert alert-warning mt-3" style="max-width: 600px;">
        No certification record was found for the provided details.
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}