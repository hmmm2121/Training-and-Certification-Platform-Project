@using System.Security.Claims
@inject TrainingAndCertificationPlatform.Data.TrainAndCertContext _db
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrainingAndCertificationPlatform</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrainingAndCertificationPlatform.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    Training Platform
                </a>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto gap-2 align-items-xl-center">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Courses" asp-action="Index">Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="PublicLookup" asp-action="Index">Public Lookup</a>
                        </li>

                        @if (User.IsInRole("TrainingCoordinator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="CertificationTracks" asp-action="Index">Certification Tracks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TrackCourses" asp-action="Index">Track Courses</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Rooms" asp-action="Index">Rooms</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Enrollments" asp-action="Index">Enrollments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Payments" asp-action="Index">Payments</a>
                            </li>
                        }

                        @if (User.IsInRole("TrainingCoordinator") || User.IsInRole("Instructor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Assessments" asp-action="Index">Assessments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="CourseSessions" asp-action="Index">Course Sessions</a>
                            </li>
                        }

                        @if (User.IsInRole("Trainee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="CourseSessions" asp-action="Index">Course Sessions</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Enrollments" asp-action="Index">My Enrollments</a>
                            </li>
                        }

                        @if (User.IsInRole("TrainingCoordinator") || User.IsInRole("Trainee"))
                        {
                            <li class="nav-link text-dark">
                                <a class="nav-link text-dark" asp-controller="CertificationProgress" asp-action="Index">Certification Progress</a>
                            </li>
                        }

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            var appUserIdClaim = User.FindFirst("AppUserId");
                            if (appUserIdClaim != null)
                            {
                                var userId = int.Parse(appUserIdClaim.Value);
                                var unreadCount = _db.Notifications.Count(n => n.UserId == userId && !n.IsRead);
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Notifications" asp-action="Index">
                                        Notifications
                                        @if (unreadCount > 0)
                                        {
                                            <span class="badge bg-danger">@unreadCount</span>
                                        }
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }

                        @if (User?.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item">
                                <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Login">Log In</a>
                            </li>
                        }

                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("TrainingCoordinator"))
                        {
                            <li class="nav-item">
                                <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="CreateInstructor">
                                    Create Instructor
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container-fluid px-5">
            &copy; 2026 - TrainingAndCertificationPlatform -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>