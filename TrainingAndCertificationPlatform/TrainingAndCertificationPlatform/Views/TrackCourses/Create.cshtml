@model TrainingAndCertificationPlatform.Models.TrackCourse

@{
    ViewData["Title"] = "Create Track Course";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">

        <div class="text-center mb-4">
            <h1 class="fw-bold">Create Track Course</h1>
            <p class="text-muted">
                Assign a course to a certification track.
            </p>
        </div>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TrackId" class="form-label"></label>
                <select asp-for="TrackId" class="form-select" asp-items="ViewBag.TrackId"></select>
            </div>

            <div class="mb-4">
                <label asp-for="CourseId" class="form-label"></label>
                <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId"></select>
            </div>

            <button type="submit" class="btn btn-dark w-100 mb-3">
                Create Track Course
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary w-100">
                Back to Track Courses
            </a>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}