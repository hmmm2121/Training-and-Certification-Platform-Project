@model TrainingAndCertificationPlatform.Models.TrackCourse

@{
    ViewData["Title"] = "Edit Track Course";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">

        <div class="text-center mb-4">

            <h1 class="fw-bold">
                Edit Track Course
            </h1>

            <p class="text-muted">
                Update the assigned course for this certification track.
            </p>

        </div>

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">

                <label asp-for="TrackId"
                       class="form-label">
                </label>

                <select asp-for="TrackId"
                        class="form-select"
                        asp-items="ViewBag.TrackId">
                </select>

                <span asp-validation-for="TrackId"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="CourseId"
                       class="form-label">
                </label>

                <select asp-for="CourseId"
                        class="form-select"
                        asp-items="ViewBag.CourseId">
                </select>

                <span asp-validation-for="CourseId"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-dark w-100 mb-3">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary w-100">
                Back to Track Courses
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}