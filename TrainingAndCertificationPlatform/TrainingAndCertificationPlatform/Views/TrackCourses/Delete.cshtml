@model TrainingAndCertificationPlatform.Models.TrackCourse

@{
    ViewData["Title"] = "Delete Track Course";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Track Course
        </h1>

        <p class="text-muted">
            Review the assigned course before deleting it from the certification track.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this track course assignment?
        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Course
            </div>

            <div class="col-md-9">
                @Model.Course?.Title
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Certification Track
            </div>

            <div class="col-md-9">
                @Model.Track?.Name
            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-2">

                <input type="submit"
                       value="Delete Track Course"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Track Courses
                </a>

            </div>

        </form>

    </div>

</div>