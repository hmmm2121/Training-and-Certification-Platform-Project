@model IEnumerable<TrainingAndCertificationPlatform.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold">Notifications</h1>

        <p class="text-muted mb-0">
            View system updates, reminders, and trainee notifications.
        </p>
    </div>

    @if (Model != null && Model.Any())
    {
        <form asp-action="ClearAll" method="post"
              onsubmit="return confirm('Clear all notifications?');">
            <button type="submit" class="btn btn-outline-danger">
                Clear All
            </button>
        </form>
    }

</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm">
        You have no notifications.
    </div>
}
else
{
    <div class="row">

        @foreach (var notification in Model)
        {
            <div class="col-md-6 mb-4">

                <div class="card p-3 h-100 shadow-sm
                                            @(!notification.IsRead ? "border-warning" : "")">

                    <div class="d-flex justify-content-between align-items-start mb-2">

                        <h5 class="fw-semibold mb-0">
                            Notification
                        </h5>

                        <small class="text-muted">
                            @notification.CreatedAt?.ToString("dd MMM yyyy, hh:mm tt")
                        </small>

                    </div>

                    <p class="mb-3">
                        @notification.Message
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-auto">

                        @if (!notification.IsRead)
                        {
                            <span class="badge bg-warning text-dark">
                                New
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Read
                            </span>
                        }

                        <form asp-action="Clear" method="post">
                            <input type="hidden" name="id" value="@notification.NotificationId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Clear
                            </button>
                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}