@model TrainingAndCertificationPlatform.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Course
        </h1>

        <p class="text-muted">
            Review the course information before deleting it permanently.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this course?
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Title
            </div>

            <div class="col-md-9">
                @Model.Title
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Description
            </div>

            <div class="col-md-9">
                @Model.Description
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Duration Hours
            </div>

            <div class="col-md-9">
                @Model.DurationHours
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Capacity
            </div>

            <div class="col-md-9">
                @Model.Capacity
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Fee
            </div>

            <div class="col-md-9">
                @Model.Fee BD
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Prerequisite Course
            </div>

            <div class="col-md-9">
                @(Model.PrerequisiteCourse != null
                                ? Model.PrerequisiteCourse.Title
                                : "None")
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 fw-bold">
                Subject
            </div>

            <div class="col-md-9">
                @Model.Subject?.Name
            </div>
        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="CourseId" />

            <div class="d-flex gap-2">

                <input type="submit"
                       value="Delete Course"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Courses
                </a>

            </div>

        </form>

    </div>

</div>