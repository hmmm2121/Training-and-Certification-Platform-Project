@model TrainingAndCertificationPlatform.ViewModels.CertificationProgressViewModel?

@{
    ViewData["Title"] = "Certification Progress";
}

<h1>Certification Progress</h1>

@if (User.IsInRole("TrainingCoordinator"))
{
    <form asp-action="Index" method="get" class="mb-4">
        <div class="form-group">
            <label>Trainee</label>
            <select name="traineeId" class="form-control" asp-items="ViewBag.TraineeId"></select>
        </div>

        <div class="form-group">
            <label>Certification Track</label>
            <select name="trackId" class="form-control" asp-items="ViewBag.TrackId"></select>
        </div>

        <button type="submit" class="btn btn-primary mt-2">
            View Progress
        </button>
    </form>
}

@if (Model == null)
{
    <div class="alert alert-info">
        Select a trainee and certification track to view progress.
    </div>

    return;
}

<h4>@Model.TraineeName</h4>
<p><strong>Certification Track:</strong> @Model.TrackName</p>

@if (Model.IsEligible)
{
    <div class="alert alert-success">
        Eligible for certification
    </div>
}
else
{
    <div class="alert alert-warning">
        Not eligible yet
    </div>
}

<h5>Required Courses</h5>
<ul>
    @foreach (var course in Model.RequiredCourses)
    {
        <li>@course</li>
    }
</ul>

<h5>Completed Courses</h5>
<ul>
    @foreach (var course in Model.CompletedCourses)
    {
        <li>@course</li>
    }
</ul>

<h5>Missing Courses</h5>
<ul>
    @foreach (var course in Model.MissingCourses)
    {
        <li>@course</li>
    }
</ul>