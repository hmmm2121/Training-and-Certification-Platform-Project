@model TrainingAndCertificationPlatform.Models.CertificationTrack

@{
    ViewData["Title"] = "Delete Certification Track";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            Delete Certification Track
        </h1>

        <p class="text-muted">
            Review the certification track information before deleting it permanently.
        </p>

    </div>

    <div class="card shadow-sm p-4 border-danger">

        <div class="alert alert-warning mb-4">
            Are you sure you want to delete this certification track?
        </div>

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Track Name
            </div>

            <div class="col-md-9">
                @Model.Name
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Description
            </div>

            <div class="col-md-9">
                @Model.Description
            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="TrackId" />

            <div class="d-flex gap-2">

                <input type="submit"
                       value="Delete Track"
                       class="btn btn-danger" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Tracks
                </a>

            </div>

        </form>

    </div>

</div>