@model TrainingAndCertificationPlatform.Models.CertificationTrack

@{
    ViewData["Title"] = "Certification Track Details";
}

<div class="mt-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            Certification Track Details
        </h1>

        <p class="text-muted">
            View complete information about this certification track.
        </p>

    </div>

    <div class="card shadow-sm p-4">

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Track Name
            </div>

            <div class="col-md-9">
                @Model.Name
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Description
            </div>

            <div class="col-md-9">
                @Model.Description
            </div>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.TrackId"
               class="btn btn-dark">
                Edit Track
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Tracks
            </a>

        </div>

    </div>

</div>