@model List<EnrollmentStatViewModel>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Training & Certification – Reports</h1>
            <small class="text-muted">Enrollment statistics by course and subject</small>
        </div>
        <a asp-controller="Reports" asp-action="EnrollmentStats" class="btn btn-outline-secondary">
            Refresh
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            <strong>API error:</strong> @ViewBag.Error
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-info">
            No enrollment data available yet.
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Total enrollments</div>
                        <div class="h4 mb-0">
                            @Model.Sum(m => m.TotalEnrollments)
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Total completed</div>
                        <div class="h4 mb-0 text-success">
                            @Model.Sum(m => m.Completed)
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Total dropped</div>
                        <div class="h4 mb-0 text-danger">
                            @Model.Sum(m => m.Dropped)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <strong>Enrollment by course</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Course</th>
                            <th>Subject</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Completed</th>
                            <th class="text-end">Dropped</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Course</td>
                                <td>@item.Subject</td>
                                <td class="text-end">@item.TotalEnrollments</td>
                                <td class="text-end text-success">@item.Completed</td>
                                <td class="text-end text-danger">@item.Dropped</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>