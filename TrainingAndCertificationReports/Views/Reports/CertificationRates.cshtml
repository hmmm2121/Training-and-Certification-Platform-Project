@model List<CertificationRateViewModel>

@{
    ViewData["Title"] = "Certification Rates";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
else if (!Model.Any())
{
    <div class="alert alert-info">No certification data available.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total tracks</div>
                    <div class="h4 mb-0">@Model.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Average completion</div>
                    <div class="h4 mb-0 text-success">
                        @Model.Average(x => x.CompletionRatePercent).ToString("0.0")%
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <strong>Certification completion by track</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Track</th>
                        <th class="text-end">Total trainees</th>
                        <th class="text-end">Eligible</th>
                        <th class="text-end">Completion %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Track</td>
                            <td class="text-end">@item.TotalTrainees</td>
                            <td class="text-end">@item.Eligible</td>
                            <td class="text-end">@item.CompletionRatePercent.ToString("0.0")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}