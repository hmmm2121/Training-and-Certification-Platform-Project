@model TrainingPlatform.MVC.Models.CertificationLookupViewModel

@{
    ViewData["Title"] = "Certification Lookup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Public Certification Lookup</h2>
    <p class="text-muted">Enter your Trainee ID and Certificate Reference Number to view your certification status. No login required.</p>

    <div class="card mt-3">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Trainee ID</label>
                    <input type="text" name="TraineeId" value="@Model.TraineeId"
                           class="form-control" placeholder="Enter your Trainee ID" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Certificate Reference Number</label>
                    <input type="text" name="CertificateRef" value="@Model.CertificateRef"
                           class="form-control" placeholder="Enter your Certificate Reference Number" />
                </div>
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.Found)
    {
        <div class="card mt-4 border-success">
            <div class="card-header bg-success text-white">
                <h4>Certification Found</h4>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <th>Trainee Name</th>
                        <td>@Model.TraineeName</td>
                    </tr>
                    <tr>
                        <th>Certification Track</th>
                        <td>@Model.TrackName</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            <span class="badge @(Model.CertificationStatus == "Issued" ? "bg-success" : "bg-warning")">
                                @Model.CertificationStatus
                            </span>
                        </td>
                    </tr>
                    @if (Model.IssuedAt != null)
                    {
                        <tr>
                            <th>Issued At</th>
                            <td>@Model.IssuedAt?.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </table>

                <h5 class="mt-3">Completed Courses</h5>
                @if (Model.CompletedCourses.Any())
                {
                    <ul class="list-group">
                        @foreach (var course in Model.CompletedCourses)
                        {
                            <li class="list-group-item">✅ @course</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No completed courses found.</p>
                }
            </div>
        </div>
    }
</div>